# Block ALL web access to signing keys. The private key must never be fetchable.
# (Better still: keep keys outside the webroot and point verify.php at that path.)

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
