# Deny direct HTTP access to files the browser never requests.
#
# The templates are compiled server-side and the stylesheet and script are
# read by PHP and inlined into the page, so nothing in this module is fetched
# by URL. Without this, every .tpl here would be readable at its public address.
#
# .php is left alone: the server executes those rather than serving their
# source, and a deny would not affect the server-side require() that loads
# them.
#
# Guarded both ways. Under Apache 2.4 the mod_authz_core branch applies; under
# 2.2 `Require` is an unknown directive and would 500 the whole subtree, so the
# Order/Deny fallback runs there instead. Under nginx this file is ignored.
<FilesMatch "\.(tpl|css|js|json|md|ya?ml|lock|dist|sql|log|sh|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
